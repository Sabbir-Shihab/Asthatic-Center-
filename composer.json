{
    "name": "skinoveda/aesthetic-care",
    "type": "project",
    "description": "Skinoveda Aesthetic Care and Skincare Shop",
    "keywords": ["laravel", "skincare", "ecommerce"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }, "files": ["app/Support/media.php", "app/Support/locale.php"] },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": { "post-autoload-dump": ["@php artisan package:discover --ansi"], "post-create-project-cmd": ["@php artisan key:generate --ansi", "@php artisan migrate --graceful --ansi"] },
    "extra": { "laravel": { "dont-discover": [] } },
    "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
